# 复制成 .env 后填写；.env 已被 .gitignore 忽略，key 不入库（§4）

# ---- 写作侧：画像官 / 策划 / 主笔 / 封面 / 人味校订 / 守门人 ----
WRITER_BASE_URL=https://api.deepseek.com
WRITER_MODEL=deepseek-flash
WRITER_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- 读者侧：必须换一家厂商（§13）。以下两家任选其一，取消注释并填 key ----
# 阿里 Qwen / DashScope
# READER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# READER_MODEL=qwen-plus
# 智谱 GLM
# READER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# READER_MODEL=glm-4-flash
READER_API_KEY=
READER_MODEL=
READER_BASE_URL=

# ---- 可选 ----
REQUEST_TIMEOUT_S=60
MAX_RETRIES=1
